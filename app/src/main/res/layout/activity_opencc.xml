<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/standalone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/opencc_page_horizontal_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/opencc_page_horizontal_padding"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/standalone_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/standalone_subtitle"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/source_text_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/source_text"
            android:text="@string/standalone_source_label"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/source_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start|top"
            android:hint="@string/standalone_source_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxHeight="@dimen/opencc_editor_max_height"
            android:minHeight="@dimen/opencc_editor_min_height"
            android:nestedScrollingEnabled="true"
            android:nextFocusForward="@id/paste_button"
            android:overScrollMode="ifContentScrolls"
            android:padding="12dp"
            android:scrollbars="vertical" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/paste_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:nextFocusForward="@id/clear_button"
                android:text="@string/standalone_paste_action"
                android:textAllCaps="false" />

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/clear_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="48dp"
                android:nextFocusForward="@id/conversion_type"
                android:text="@string/standalone_clear_action"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/conversion_type_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/conversion_type"
            android:text="@string/standalone_conversion_type_label"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/conversion_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:nextFocusForward="@id/convert_button"
            android:spinnerMode="dropdown" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:nextFocusForward="@id/convert_button"
                android:text="@string/standalone_cancel_action"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/convert_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:nextFocusForward="@id/result_text"
                android:text="@string/standalone_convert_action"
                android:textAllCaps="false" />

            <ProgressBar
                android:id="@+id/conversion_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/standalone_progress_description"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/conversion_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:minHeight="24dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/result_text_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/result_text"
            android:text="@string/standalone_result_label"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/editTextBackground"
            android:freezesText="true"
            android:gravity="start|top"
            android:hint="@string/standalone_result_hint"
            android:maxHeight="@dimen/opencc_editor_max_height"
            android:minHeight="@dimen/opencc_editor_min_height"
            android:nestedScrollingEnabled="true"
            android:nextFocusForward="@id/copy_button"
            android:overScrollMode="ifContentScrolls"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textIsSelectable="true" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/copy_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="48dp"
                android:nextFocusForward="@id/swap_button"
                android:text="@string/standalone_copy_action"
                android:textAllCaps="false" />

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/swap_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="48dp"
                android:nextFocusForward="@id/share_button"
                android:text="@string/standalone_swap_action"
                android:textAllCaps="false" />

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/share_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="48dp"
                android:nextFocusForward="@id/source_text"
                android:text="@string/standalone_share_action"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/runtime_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>
</ScrollView>
